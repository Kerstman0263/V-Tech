# =====================================================================
# Saldova — Environment variabelen
# Kopieer dit bestand naar .env.local en vul de echte waarden in.
# Zet ECHTE secrets NOOIT in git (.env.local staat in .gitignore).
# =====================================================================

# --- Database (PostgreSQL) ---
# Neon / Supabase / Vercel Postgres connection string.
# DATABASE_URL  = pooled connection (gebruikt door de app at runtime)
# DIRECT_URL    = directe connection (gebruikt door Prisma migraties)
DATABASE_URL="postgresql://user:password@host:5432/vtech?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/vtech?sslmode=require"

# --- Auth (NextAuth / Auth.js v5) ---
# Genereer met:  openssl rand -base64 32
AUTH_SECRET="vervang-mij-met-een-lange-random-string"
# In productie automatisch door Vercel gezet; lokaal:
AUTH_URL="http://localhost:3000"

# --- AVG veld-encryptie (AES-256-GCM) ---
# 32-byte sleutel als hex (64 tekens). Genereer met:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="vervang-mij-64-hex-tekens"

# --- Mollie betalingen ---
# Test-key begint met test_, live-key met live_
MOLLIE_API_KEY="test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Publieke URL waar Mollie webhooks naartoe stuurt (Vercel productie-URL)
MOLLIE_WEBHOOK_URL="https://jouw-app.vercel.app/api/webhooks/mollie"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- E-mail (optioneel, voor support-/contactnotificaties via Resend) ---
# Zonder key worden e-mails alleen gelogd (no-op). Key via resend.com.
RESEND_API_KEY=""
EMAIL_FROM="Saldova <onboarding@resend.dev>"
# Adres dat support-notificaties ontvangt (anders de eerste admin)
SUPPORT_NOTIFY_EMAIL=""

# --- Automatische betaalherinneringen (Vercel-cron) ---
# Beveiligt /api/cron/send-reminders. Vercel stuurt dit als
# `Authorization: Bearer <CRON_SECRET>` mee bij de dagelijkse cron.
# Genereer met:  openssl rand -base64 32
CRON_SECRET=""

# --- Super-admin seed (alleen nodig voor `npm run db:seed`) ---
ADMIN_EMAIL="jij@saldova.nl"
ADMIN_PASSWORD="een-sterk-admin-wachtwoord"
